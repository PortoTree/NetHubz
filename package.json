{
  "name": "nethubz.com-monorepo",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --prefix apps/web\" \"npm run start:dev --prefix apps/api\"",
    "dev:api": "npm run start:dev --prefix apps/api",
    "dev:web": "npm run dev --prefix apps/web",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "postinstall": "npx prisma@5.21.0 generate"
  },
  "devDependencies": {
    "concurrently": "^9.2.4"
  },
  "dependencies": {
    "@prisma/client": "^5.21.0",
    "cloudinary": "^2.11.0",
    "prisma": "^5.21.0"
  }
}