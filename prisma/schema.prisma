generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                    String           @id @default(uuid())
  username              String           @unique
  email                 String           @unique
  passwordHash          String
  status                String           @default("ACTIVE")
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  resetOtpCode          String?          @db.VarChar(6)
  resetOtpExpiresAt     DateTime?
  phone                 String?
  blocksReceived        Block[]          @relation("BlockBlockedUser")
  blocksSent            Block[]          @relation("BlockUser")
  following             Follow[]         @relation("UserFollowing")
  followers             Follow[]         @relation("UserFollowers")
  friendshipsAsFriend   Friendship[]     @relation("FriendshipFriend")
  friendRequestsSent    Friendship[]     @relation("FriendshipRequester")
  friendshipsAsUser     Friendship[]     @relation("FriendshipUser")
  posts                 Post[]
  profile               Profile?
  profileSettings       ProfileSettings?
  socialLinks           UserSocialLink[]
  notificationsReceived Notification[]   @relation("NotificationRecipient")
  notificationsSent     Notification[]   @relation("NotificationSender")
  comments              Comment[]
  likes                 Like[]
  savedPosts            SavedPost[]
  savedProjects         SavedProject[]
  folders               Folder[]
  folderMembers         FolderMember[]
  taggedInPosts         Post[]           @relation("PostTags")
  Media                 Media[]
  galleries             Gallery[]
  projects              Project[]
  giveawayEntries       GiveawayEntry[]
}

model PendingUser {
  id           String   @id @default(uuid())
  email        String   @unique
  username     String
  passwordHash String
  otpCode      String   @db.VarChar(6)
  createdAt    DateTime @default(now())
}

model Profile {
  id                     String      @id @default(uuid())
  userId                 String      @unique
  displayName            String
  bio                    String?
  avatarUrl              String?
  coverUrl               String?
  birthDate              DateTime?
  community              String?
  createdAt              DateTime    @default(now())
  gender                 String?
  groupChat              String?
  locationId             String?
  socialMedia            String?
  type                   ProfileType @default(PERSONAL)
  updatedAt              DateTime    @default(now()) @updatedAt
  websiteUrl             String?
  displayNameChangeDates DateTime[]  @default(dbgenerated("(ARRAY[]::timestamp without time zone[])::timestamp(3) without time zone[]"))
  education              String?
  locationName           String?
  profession             String?
  externalLinks          Json?       @default("[]")
  games                  String[]    @default([])
  hardSkills             String[]    @default([])
  hobbies                String[]    @default([])
  movies                 String[]    @default([])
  music                  String[]    @default([])
  softSkills             String[]    @default([])
  softwareSkills         String[]    @default([])
  sports                 String[]    @default([])
  tvShows                String[]    @default([])
  location               Location?   @relation(fields: [locationId], references: [id])
  user                   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ProfileSettings {
  userId              String             @id
  profileVisibility   ProfileVisibility  @default(PUBLIC)
  privacyGender       ProfileVisibility  @default(PUBLIC)
  privacyBirth        ProfileVisibility  @default(PUBLIC)
  privacyLoc          ProfileVisibility  @default(PUBLIC)
  privacyProf         ProfileVisibility  @default(PUBLIC)
  privacySosmed       ProfileVisibility  @default(PUBLIC)
  privacyFriendList   ProfileVisibility  @default(PUBLIC)
  privacyFollowers    ProfileVisibility  @default(PUBLIC)
  privacyFollowing    ProfileVisibility  @default(PUBLIC)
  privacyActivity     ProfileVisibility  @default(PUBLIC)
  privacyOwnedGroups  ProfileVisibility  @default(PUBLIC)
  privacyJoinedGroups ProfileVisibility  @default(PUBLIC)
  privacyExternalLink ProfileVisibility  @default(PUBLIC)
  privacyTag          ProfileVisibility  @default(PUBLIC)
  privacyComment      InteractionPrivacy @default(PUBLIC)
  privacyOnline       InteractionPrivacy @default(PUBLIC)
  privacyDM           Boolean            @default(true)
  showBirthDate       Boolean            @default(true) // Deprecated: replaced by privacyBirth
  showLocation        Boolean            @default(true) // Deprecated: replaced by privacyLoc
  allowFollow         Boolean            @default(true)
  allowFriendRequest  Boolean            @default(true)
  searchable          Boolean            @default(true)
  user                User               @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserSocialLink {
  id           String @id @default(uuid())
  userId       String
  platform     String
  url          String
  displayOrder Int    @default(0)
  user         User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Location {
  id       String    @id @default(uuid())
  country  String
  province String
  city     String
  district String?
  profiles Profile[]
}

model Follow {
  id          String   @id @default(uuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  follower    User     @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
}

model Friendship {
  id          String           @id @default(uuid())
  userId      String
  friendId    String
  requestedBy String
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  acceptedAt  DateTime?
  friend      User             @relation("FriendshipFriend", fields: [friendId], references: [id], onDelete: Cascade)
  requester   User             @relation("FriendshipRequester", fields: [requestedBy], references: [id], onDelete: Cascade)
  user        User             @relation("FriendshipUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, friendId])
}

model Block {
  id            String   @id @default(uuid())
  userId        String
  blockedUserId String
  createdAt     DateTime @default(now())
  blockedUser   User     @relation("BlockBlockedUser", fields: [blockedUserId], references: [id], onDelete: Cascade)
  user          User     @relation("BlockUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, blockedUserId])
}

model Post {
  id           String         @id @default(uuid())
  content      String
  type         PostType       @default(NORMAL)
  visibility   PostVisibility @default(PUBLIC)
  label        PostLabel      @default(DEFAULT)
  mediaLayout  String         @default("GRID") // "GRID" or "CAROUSEL"
  authorId     String
  communityId  String? // Prepared for community phase
  sharedPostId String?
  linkMetadata Json?
  galleryId    String?
  projectId    String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  author        User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  gallery       Gallery?       @relation(fields: [galleryId], references: [id], onDelete: SetNull)
  project       Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  sharedPost    Post?          @relation("PostShares", fields: [sharedPostId], references: [id], onDelete: SetNull)
  shares        Post[]         @relation("PostShares")
  shareCount    Int            @default(0)
  comments      Comment[]
  likes         Like[]
  savedBy       SavedPost[]
  notifications Notification[]
  postMedia     PostMedia[]
  taggedUsers   User[]         @relation("PostTags")
  hashtags      Hashtag[]      @relation("PostToHashtag")
  giveaway      Giveaway?
}

model Giveaway {
  id                String             @id @default(uuid())
  postId            String             @unique
  title             String?            @db.VarChar(9)
  rewardType        GiveawayRewardType
  rewardLink        String // SECRET: never expose in post API, only via notification to recipients
  notes             String?
  endsAt            DateTime
  mode              GiveawayMode       @default(ALL_ELIGIBLE)
  winnerCount       Int? // used when mode = RANDOM_DRAW
  maxParticipants   Int? // null = unlimited
  minAccountAgeDays Int                @default(0) // 0 = disabled
  status            GiveawayStatus     @default(ACTIVE)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  post         Post                  @relation(fields: [postId], references: [id], onDelete: Cascade)
  requirements GiveawayRequirement[]
  entries      GiveawayEntry[]

  @@index([status, endsAt])
}

model GiveawayRequirement {
  id         String                  @id @default(uuid())
  giveawayId String
  type       GiveawayRequirementType
  targetId   String? // userId (FOLLOW_USER) or groupId (JOIN_GROUP)
  url        String? // EXTERNAL_SOCIAL link
  platform   String? // instagram, tiktok, x, youtube, etc
  order      Int                     @default(0)

  giveaway Giveaway @relation(fields: [giveawayId], references: [id], onDelete: Cascade)
}

model GiveawayEntry {
  id                String              @id @default(uuid())
  giveawayId        String
  userId            String
  status            GiveawayEntryStatus @default(PENDING)
  externalUsernames Json?               @default("{}") // { requirementId: "@username" }
  clickedLinks      String[]            @default([]) // requirementIds whose external link was clicked
  rewardSentAt      DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  giveaway Giveaway @relation(fields: [giveawayId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([giveawayId, userId])
}

enum GiveawayRewardType {
  GDRIVE_LINK
  OTHER_LINK
}

enum GiveawayMode {
  ALL_ELIGIBLE
  RANDOM_DRAW
}

enum GiveawayStatus {
  ACTIVE
  ENDED
  CANCELLED
}

enum GiveawayRequirementType {
  FOLLOW_USER
  JOIN_GROUP
  EXTERNAL_SOCIAL
}

enum GiveawayEntryStatus {
  PENDING
  ELIGIBLE
  WINNER
  REJECTED
}

model Comment {
  id        String   @id @default(uuid())
  content   String
  postId    String?
  projectId String?
  authorId  String
  parentId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  post          Post?          @relation(fields: [postId], references: [id], onDelete: Cascade)
  project       Project?       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author        User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent        Comment?       @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies       Comment[]      @relation("CommentReplies")
  likes         Like[]
  notifications Notification[]
}

model Like {
  id        String   @id @default(uuid())
  userId    String
  postId    String?
  commentId String?
  projectId String?
  type      String   @default("LIKE") // Values: LIKE, LOVE, HAHA, WOW, SAD, ANGRY, IWW
  createdAt DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post    Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  comment Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Ensure a user can only like a specific post, comment, or project once
  @@unique([userId, postId, commentId, projectId])
}

model SavedPost {
  id        String   @id @default(uuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())

  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  post     Post    @relation(fields: [postId], references: [id], onDelete: Cascade)
  Folder   Folder? @relation(fields: [folderId], references: [id])
  folderId String?

  @@unique([userId, postId])
}

model SavedProject {
  id        String   @id @default(uuid())
  userId    String
  projectId String
  createdAt DateTime @default(now())

  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project  Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  Folder   Folder? @relation(fields: [folderId], references: [id])
  folderId String?

  @@unique([userId, projectId])
}

model Notification {
  id     String           @id @default(uuid())
  type   NotificationType
  isRead Boolean          @default(false)

  // The user who receives the notification
  userId String
  user   User   @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)

  // The user who triggered the notification (optional)
  senderId String?
  sender   User?   @relation("NotificationSender", fields: [senderId], references: [id], onDelete: Cascade)

  // Optional relations to other entities (e.g. Post, Comment) when they exist
  postId String?
  post   Post?   @relation(fields: [postId], references: [id], onDelete: Cascade)

  commentId String?
  comment   Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  reactionType String? // To store which reaction was given (LIKE, LOVE, HAHA, etc)

  createdAt DateTime @default(now())
}

enum ProfileType {
  PERSONAL
  BUSINESS
}

enum ProfileVisibility {
  PUBLIC
  FRIENDS
  PRIVATE
}

enum PostVisibility {
  PUBLIC
  FRIENDS
  PRIVATE
  COMMUNITY_ONLY
}

enum PostLabel {
  DEFAULT
  MENCARI
  LOKASI
  PROFESI
  SEKOLAH
}

enum InteractionPrivacy {
  PUBLIC
  FRIENDS
  TURN_OFF
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  REJECTED
  BLOCKED
}

enum PostType {
  NORMAL
  SEARCHING
  OFFERING
  QUESTION
  POLL
  ANNOUNCEMENT
}

enum NotificationType {
  FOLLOW
  FRIEND_REQUEST
  FRIEND_ACCEPT
  FRIEND_NOW
  POST_LIKE
  POST_COMMENT
  COMMENT_REPLY
  COMMENT_MENTION
  POST_SHARE
  POST_TAG
  GIVEAWAY_JOINED
  GIVEAWAY_WON
  GIVEAWAY_REWARD
  GIVEAWAY_ENDED
  COMMENT_LIKE
  PROJECT_LIKE
  PROJECT_COMMENT
  PROJECT_SHARE
}

model Media {
  id              String   @id @default(uuid())
  userId          String
  type            String // IMAGE, VIDEO, AUDIO, FILE
  provider        String   @default("cloudinary")
  providerAccount String?
  publicId        String
  version         String?
  mimeType        String?
  fileSize        Int?
  width           Int?
  height          Int?
  duration        Float?
  originalUrl     String
  thumbUrl        String?
  feedUrl         String?
  detailUrl       String?
  status          String   @default("ACTIVE") // ACTIVE, DELETED, PENDING
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  postMedia    PostMedia[]
  projectMedia ProjectMedia[]
}

model PostMedia {
  postId  String
  mediaId String
  order   Int    @default(0)

  post  Post  @relation(fields: [postId], references: [id], onDelete: Cascade)
  media Media @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([postId, mediaId])
}

model ProjectMedia {
  projectId String
  mediaId   String
  order     Int     @default(0)
  isCover   Boolean @default(false)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  media   Media   @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([projectId, mediaId])
}

model Hashtag {
  id        String   @id @default(uuid())
  name      String   @unique
  count     Int      @default(0)
  createdAt DateTime @default(now())

  posts Post[] @relation("PostToHashtag")
}

model Gallery {
  id        String   @id @default(uuid())
  name      String
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  posts    Post[]
  privacy  String  @default("PUBLIC")
  coverUrl String?
}

model Project {
  id          String        @id @default(uuid())
  userId      String
  title       String
  description String        @db.Text
  status      ProjectStatus @default(RELEASED)
  techStack   String[]      @default([])
  repoUrl     String?
  demoUrl     String?
  coverUrls   String[]      @default([])
  mediaUrls   String[]      @default([])
  roleNeeded  String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  category        ProjectCategory @default(WEB_DEV)
  customCategory  String?
  collabTypes     CollabType[]
  linkedProductId String?
  isForSale       Boolean         @default(false)
  shareCount      Int             @default(0)

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  posts         Post[]
  comments      Comment[]
  likes         Like[]
  savedBy       SavedProject[]
  notifications Notification[]
  projectMedia  ProjectMedia[]
}

enum ProjectStatus {
  RELEASED
  IN_PROGRESS
  SEARCHING_TEAM
  OPEN_SOURCE
  HIATUS
}

enum ProjectCategory {
  WEB_DEV
  MOBILE_APP
  GAME_DEV
  DATA_AI
  DESKTOP_APP
  OPEN_SOURCE
  UI_UX
  GRAPHIC_DESIGN
  ANIMATION_3D
  VIDEO_FILM
  MUSIC_AUDIO
  ECOMMERCE
  SAAS
  FINTECH
  SOCIAL_IMPACT
  IOT
  ROBOTICS
  ELECTRONICS
  EDTECH
  RESEARCH
  OTHER
}

enum CollabType {
  FINDING_TEAM
  FINDING_MENTOR
  FINDING_TESTER
  FINDING_INVESTOR
}

model Folder {
  id          String   @id @default(uuid())
  name        String
  description String?
  userId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  members       FolderMember[]
  savedPosts    SavedPost[]
  savedProjects SavedProject[]

  @@index([userId])
}

model FolderMember {
  id        String   @id @default(uuid())
  folderId  String
  userId    String
  role      String   @default("VIEWER")
  createdAt DateTime @default(now())

  folder Folder @relation(fields: [folderId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([folderId, userId])
}
